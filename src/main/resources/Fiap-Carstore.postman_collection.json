		{
			"name": "Get Token",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const username = pm.environment.get(\"USERNAME\");\r",
							"const clientId = pm.environment.get(\"CLIENT_ID\");\r",
							"const clientSecret = pm.environment.get(\"CLIENT_SECRET\");\r",
							"\r",
							"async function generateSecretHash(username, clientId, clientSecret) {\r",
							"    const encoder = new TextEncoder();\r",
							"    const key = await crypto.subtle.importKey(\r",
							"        \"raw\",\r",
							"        encoder.encode(clientSecret),\r",
							"        { name: \"HMAC\", hash: \"SHA-256\" },\r",
							"        false,\r",
							"        [\"sign\"]\r",
							"    );\r",
							"\r",
							"    const signature = await crypto.subtle.sign(\r",
							"        \"HMAC\",\r",
							"        key,\r",
							"        encoder.encode(username + clientId)\r",
							"    );\r",
							"\r",
							"    const base64 = btoa(String.fromCharCode(...new Uint8Array(signature)));\r",
							"    return base64;\r",
							"}\r",
							"\r",
							"generateSecretHash(username, clientId, clientSecret)\r",
							"    .then(secretHash => {\r",
							"        pm.environment.set(\"SECRET_HASH\", secretHash);\r",
							"    })\r",
							"    .catch(err => console.error(\"Error generating SecretHash\", err));\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
