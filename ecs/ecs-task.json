{
  "family": "carstore-veiculos-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::797666780798:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::797666780798:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "carstore-service-veiculos",
      "image": "797666780798.dkr.ecr.us-east-1.amazonaws.com/carstore:veiculos-latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "COGNITO_CLIENT_ID", "value": "6qkenoi25edom3tr9k5ar2eni0" },
        { "name": "COGNITO_REGION", "value": "us-east-1" },
        { "name": "COGNITO_USER_POOL_ID", "value": "us-east-1_zV9ZTahOx" },
        { "name": "DB_HOST", "value": "carstore-rds.cgtguu4oq8ce.us-east-1.rds.amazonaws.com" },
        { "name": "DB_NAME", "value": "carstore" },
        { "name": "DB_USERNAME", "value": "postgres" },
        { "name": "DB_PASSWORD", "value": "postgres" },
        { "name": "DB_PORT", "value": "5432" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/carstore-veiculos",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
